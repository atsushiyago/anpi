# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys, tokens, or phone numbers.

# --- CALL-E ---
# API key (from https://docs.heycall-e.com/ dashboard)
CALLE_API_KEY=
# Required — an empty value causes an "Invalid URL" error when placing calls.
CALLE_BASE_URL=https://api.heycall-e.com
# Dummy/test phone number in E.164 format, used ONLY by scripts/test-call.mts.
# Must belong to someone who has consented to receiving this test call.
CALLE_TEST_PHONE=
CALLE_TEST_RECIPIENT_NAME=

# --- Storage (Upstash Redis, REST API) ---
# From the Upstash console (https://console.upstash.com/) → your Redis
# database → REST API section. Free tier is enough for this project's scale.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email notifications (Resend) ---
RESEND_API_KEY=
# Used ONLY by scripts/test-notify.mts.
FAMILY_TEST_EMAIL=

# --- Vercel Cron ---
# Shared secret checked against the Authorization header on the cron route.
# Low priority while Cron is unused.
CRON_SECRET=
